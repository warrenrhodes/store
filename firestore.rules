rules_version = '2';

// Both apps read and write through firebase-admin on the server, which ignores these rules;
// store isolation is enforced there (nature_gift_admin/lib/tenant.ts). The browser only reads
// its own users/{uid} profile right after signing in to the admin (lib/actions/client.ts).
// Everything else is closed to browsers. docs/MULTI_TENANT_PLAN.md, 3.6.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
