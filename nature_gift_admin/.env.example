# Admin (nature_gift_admin). Copy to .env for local dev; production values are in apphosting.yaml.

# --- Required ---
# Storefront platform link (store links: <this>/boutique/<slug>), no trailing slash.
NEXT_PUBLIC_PLATFORM_URL=http://localhost:3001
# This admin's own link (rich text editor uploads).
NEXT_PUBLIC_ADMIN_DASHBOARD_URL=http://localhost:3000

# Firebase web app (Firebase console, Project settings).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Service account (Firebase console, Service accounts). The key on one line, with \n.
# Also read by the scripts in scripts/ (--env nature_gift_admin/.env).
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Session cookies: two random strings (openssl rand -base64 32). "true" in production (HTTPS).
AUTH_COOKIE_SIGNATURE_KEY_CURRENT=
AUTH_COOKIE_SIGNATURE_KEY_PREVIOUS=
USE_SECURE_COOKIES=false

# Image uploads (Cloudinary console, API keys).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Same value as in the storefront: clears its cache after an edit (else up to 5 minutes late).
REVALIDATE_SECRET=

# --- Optional ---
# Platform WhatsApp (international, digits only) shown to stores waiting for payment or suspended.
PLATFORM_CONTACT_WHATSAPP=
# NotificationAPI (same account as the storefront): email to a store's owner when its first
# payment opens the storefront (notification "store_activated", merge tags store_name,
# store_url, paid_until). Blank: nothing is sent.
NOTIFICATIONAPI_CLIENT_ID=
NOTIFICATIONAPI_CLIENT_SECRET=

# Tests only, set by scripts/e2e/env.cjs: E2E_DIST_DIR, FIREBASE_AUTH_EMULATOR_HOST,
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST, NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST.
