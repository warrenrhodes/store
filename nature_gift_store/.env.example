# Storefront (nature_gift_store). Copy to .env for local dev; production values are in apphosting.yaml.
# Every store's own channels (WhatsApp, emails, SMS, GTM, Meta Pixels and CAPI tokens, Flock) are
# set in the admin, Settings: they are not environment variables.

# --- Required ---
# Platform link the storefront runs on (stores are under /boutique/<slug>), no trailing slash.
NEXT_PUBLIC_PLATFORM_URL=http://localhost:3001
# Admin dashboard link: links in order alerts, and the only origin the theme editor's live
# preview accepts color changes from.
NEXT_PUBLIC_ADMIN_DASHBOARD_URL=http://localhost:3000

# Firebase web app (Firebase console, Project settings).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Service account (Firebase console, Service accounts). The key on one line, with \n.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Session cookies: two random strings (openssl rand -base64 32). "true" in production (HTTPS).
AUTH_COOKIE_SIGNATURE_KEY_CURRENT=
AUTH_COOKIE_SIGNATURE_KEY_PREVIOUS=
USE_SECURE_COOKIES=false

# Same value as in the admin: lets the admin clear the storefront cache after an edit.
REVALIDATE_SECRET=

# --- Optional (the platform's own, never a store's) ---
# GTM container of the marketplace pages.
PLATFORM_GTM_ID=
# Where the marketplace contact form sends (comma-separated). A store's form goes to its Settings emails.
PLATFORM_CONTACT_EMAIL=
# Flock alert when the storefront can't read Firestore.
PLATFORM_FLOCK_WEBHOOK_URL=
# NotificationAPI (every store's order alerts by email and SMS, contact messages). The content
# is in the code (packages/core/src/emails.ts): no template to create there. Blank: nothing is sent.
NOTIFICATIONAPI_CLIENT_ID=
NOTIFICATIONAPI_CLIENT_SECRET=
# Meta Events Manager test code, to see the Conversions API events in "Test events".
META_TEST_EVENT_CODE=

# Tests only, set by scripts/e2e/env.cjs: E2E_DIST_DIR, META_GRAPH_URL,
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST, NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST.
